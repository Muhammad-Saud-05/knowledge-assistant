POSTGRES_USER=kb_user
POSTGRES_DB=knowledge_base
POSTGRES_PASSWORD=change-me

# Local language model (Ollama)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_KEEP_ALIVE=30m

# Web app settings (optional; the values shown are the defaults)
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# MAX_UPLOAD_MB=25

# Cross-encoder reranker (used only when reranking is switched on)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# true (default): search = vector candidates reranked by the cross-encoder; false: plain hybrid search
RERANKER_ENABLED=true
